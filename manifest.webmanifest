            "icons": [{ "src": "/images/HLL_Icons/Map Markers/icn_tank_marker.png", "sizes": "192x192" }]
        },
        {
            "name": "Tankulator",
            "short_name": "Tankulator",
            "url": "/app.html#/armor/wwii/tankulator?focus=1",
            "icons": [{ "src": "/images/HLL_Icons/Map Markers/icn_tank_marker.png", "sizes": "192x192" }]
        },
        {
            "name": "Mortar Calculator",
            "short_name": "Mortar",
